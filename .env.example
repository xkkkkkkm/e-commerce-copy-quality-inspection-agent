# The application requires MySQL. Docker Compose overrides the hostname to mysql.
DATABASE_URL=mysql+pymysql://quality_agent:quality_agent@127.0.0.1:3307/quality_agent?charset=utf8mb4
MYSQL_DATABASE=quality_agent
MYSQL_USER=quality_agent
MYSQL_PASSWORD=quality_agent
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PORT=3307

# Local process uses localhost; Compose overrides this to the service name.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=quality_rules
ELASTICSEARCH_TIMEOUT_SECONDS=2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_RETRIES=1

APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=local
APP_MAX_BODY_BYTES=262144

# Local administrator demo. Change the password for shared deployments.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_SESSION_HOURS=8
ADMIN_COOKIE_SECURE=false

# Operator-owned registry; never commit its actual contents.
TENANTS_FILE=.local/runtime/tenants.json
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_PORT=6380
WORKER_CONCURRENCY=4
TENANT_MAX_PENDING_ITEMS=20000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Compose enables distributed admission. Enable for host-side services too.
LLM_DISTRIBUTED_LIMITS=false
ADMIN_DISTRIBUTED_LIMITS=false
LLM_MAX_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=60
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me
